{
  "compilerOptions": {
    "target": "ES2023",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.runner.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["runner/**/*.ts", "shared/**/*.ts"]
}
