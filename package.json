{
  "name": "parallax-ai",
  "private": true,
  "version": "0.1.0-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "node scripts/dev.mjs --preview",
    "typecheck": "tsc -b --pretty",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts",
    "test:native": "playwright test --config playwright.native.config.ts",
    "dev:web": "vite",
    "runner": "node --env-file-if-exists=.env runner/server.ts",
    "fixture": "node scripts/fixture.mjs",
    "test:runner": "node --test runner/*.test.ts",
    "test:coding": "playwright test --config playwright.coding.config.ts",
    "test:gemini:live": "node scripts/verify-gemini.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "description": "PARALLAX AI Development Multiverse - Phase 1 foundation",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
